# Copia este archivo a ".env" (en la raíz del repo) y ajusta los valores a tu entorno local.
# ".env" está en .gitignore -- nunca lo subas al repositorio.

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=tiendaya_db
PG_USER=postgres
PG_PASSWORD=cambia_esto_por_tu_password

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=tiendaya_nosql

# --- Redis (carrito de compra + oferta de inventario limitado, Entrega 2) ---
# Redis tiene control de acceso (ACL): el usuario "default" está deshabilitado y
# cada servicio usa su propio usuario (database/redis/users.acl).
#   API web            -> tiendaya_api     (solo keys carrito:* y oferta:*)
#   relevo del outbox  -> tiendaya_relevo  (solo HGET/HDEL/scripts sobre carritos y reservas)
REDIS_URL=redis://tiendaya_api:api_tiendaya_2026@localhost:6379/0
REDIS_URL_RELEVO=redis://tiendaya_relevo:relevo_tiendaya_2026@localhost:6379/0
# Usuario administrador (todo permitido): solo para scripts de prueba/operación, nunca para la API.
REDIS_URL_ADMIN=redis://tiendaya_admin:admin_tiendaya_2026@localhost:6379/0
# Segundos de inactividad tras los que expira un carrito (se refresca en cada operación).
# 0 (o negativo) = el carrito no expira (default).
CARRITO_TTL_SEGUNDOS=0
# Segundos que una reserva de oferta relámpago queda apartada en el carrito.
RESERVA_OFERTA_TTL_SEGUNDOS=60

# --- Neo4j (detección de fraude en reseñas, Entrega 2) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tiendaya123

# --- Elasticsearch (buscador del catálogo, Entrega 3) ---
ELASTICSEARCH_URL=http://localhost:9200
# Alias que apunta al índice versionado vigente (lo mueve indexar_productos_elasticsearch.py).
ES_ALIAS_PRODUCTOS=productos

# --- Componente vectorial (recomendación y búsqueda semántica, entrega final) ---
# PostgreSQL + pgvector del docker-compose (puerto 5433), con el rol de la aplicación
# (solo lee/escribe filas; no puede cambiar el esquema).
VECTORES_URL=postgresql+psycopg2://vectores_app:vectores_app_2026@localhost:5433/tiendaya_vectores
# Modelo de embeddings (se descarga solo la primera vez, ~460 MB). Si lo cambias, vuelve a
# correr database/migrations/generar_embeddings_productos.py.
MODELO_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Outbox del checkout (Entrega 3) ---
# Cada cuántos segundos el relevo reintenta los eventos de sincronización pendientes,
# y cuántos intentos hace antes de marcar un evento como "fallido".
OUTBOX_INTERVALO_SEGUNDOS=15
OUTBOX_MAX_INTENTOS=10

# --- Fallas simuladas del checkout (Entrega 3) ---
# SOLO para desarrollo y para la prueba de falla: con 1, POST /api/checkout acepta
# "simular_falla" y el checkout muestra un selector de falla. Déjalo en 0 en cualquier otro caso.
PERMITIR_FALLAS_SIMULADAS=0
