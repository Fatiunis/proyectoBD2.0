# Copia este archivo a ".env" (en la raíz del repo) y ajusta los valores a tu entorno local.
# ".env" está en .gitignore -- nunca lo subas al repositorio.

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=tiendaya_db
PG_USER=postgres
PG_PASSWORD=cambia_esto_por_tu_password

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=tiendaya_nosql

# --- Redis (carrito de compra + oferta de inventario limitado, Entrega 2) ---
REDIS_URL=redis://localhost:6379/0
# Minutos de inactividad tras los que expira un carrito (se refresca en cada operación).
CARRITO_TTL_SEGUNDOS=1800

# --- Neo4j (detección de fraude en reseñas, Entrega 2) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tiendaya123
