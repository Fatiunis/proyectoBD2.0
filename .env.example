# Copia este archivo a ".env" (en la raíz del repo) y ajusta los valores a tu entorno local.
# ".env" está en .gitignore -- nunca lo subas al repositorio.

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=tiendaya_db
PG_USER=postgres
PG_PASSWORD=cambia_esto_por_tu_password

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=tiendaya_nosql
