# Copia este archivo a ".env" (en la raíz del repo) y ajusta los valores a tu entorno local.
# ".env" está en .gitignore -- nunca lo subas al repositorio.

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=tiendaya_db
PG_USER=postgres
PG_PASSWORD=cambia_esto_por_tu_password

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=tiendaya_nosql

# --- Redis (carrito de compra + oferta de inventario limitado, Entrega 2) ---
REDIS_URL=redis://localhost:6379/0
# Segundos de inactividad tras los que expira un carrito (se refresca en cada operación).
# 0 (o negativo) = el carrito no expira (default).
CARRITO_TTL_SEGUNDOS=0
# Segundos que una reserva de oferta relámpago queda apartada en el carrito.
RESERVA_OFERTA_TTL_SEGUNDOS=60

# --- Neo4j (detección de fraude en reseñas, Entrega 2) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tiendaya123

# --- Elasticsearch (buscador del catálogo, Entrega 3) ---
ELASTICSEARCH_URL=http://localhost:9200
# Alias que apunta al índice versionado vigente (lo mueve indexar_productos_elasticsearch.py).
ES_ALIAS_PRODUCTOS=productos

# --- Outbox del checkout (Entrega 3) ---
# Cada cuántos segundos el relevo reintenta los eventos de sincronización pendientes,
# y cuántos intentos hace antes de marcar un evento como "fallido".
OUTBOX_INTERVALO_SEGUNDOS=15
OUTBOX_MAX_INTENTOS=10

# --- Fallas simuladas del checkout (Entrega 3) ---
# SOLO para desarrollo y para la prueba de falla: con 1, POST /api/checkout acepta
# "simular_falla" y el checkout muestra un selector de falla. Déjalo en 0 en cualquier otro caso.
PERMITIR_FALLAS_SIMULADAS=0
